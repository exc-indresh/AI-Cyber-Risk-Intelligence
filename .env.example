# ─────────────────────────────────────────────────────────────────────────────
# TawasolPay AI Cyber Risk Assistant — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key (free tier) — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (free tier — see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Path to the Dataset folder
DATASET_DIR=./Dataset

# Path where ChromaDB persists its vector index
CHROMA_DB_DIR=./data/chroma

# Path where downloaded external data is cached
CACHE_DIR=./data/cache

# Server settings
HOST=0.0.0.0
PORT=8000
